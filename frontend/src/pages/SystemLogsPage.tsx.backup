import React, { useState, useEffect } from 'react';
import { getLogs, getLogStats } from '../api/system';

interface Log {
  _id: string;
  tipo: string;
  categoria: string;
  accion: string;
  descripcion: string;
  usuario?: { username: string; role: string };
  usuarioNombre?: string;
  ip?: string;
  userAgent?: string;
  sessionId?: string;
  createdAt: string;
}

const SystemLogsPage: React.FC = () => {
  const [logs, setLogs] = useState<Log[]>([]);
  const [loading, setLoading] = useState(true);
  const [stats, setStats] = useState<any>(null);
  const [filters, setFilters] = useState({
    tipo: 'all',
    categoria: 'all',
    buscar: '',
    pagina: 1,
    limite: 50
  });
  const [pagination, setPagination] = useState<any>(null);

  useEffect(() => {
    loadLogs();
    loadStats();
  }, [filters.tipo, filters.categoria, filters.pagina]);

  const loadLogs = async () => {
    try {
      setLoading(true);
      const response = await getLogs(filters);
      setLogs(response.logs);
      setPagination(response.pagination);
    } catch (error) {
      console.error('Error al cargar logs:', error);
      alert('Error al cargar los logs del sistema');
    } finally {
      setLoading(false);
    }
  };

  const loadStats = async () => {
    try {
      const response = await getLogStats();
      setStats(response.stats);
    } catch (error) {
      console.error('Error al cargar estadísticas:', error);
    }
  };

  const handleSearch = () => {
    setFilters(prev => ({ ...prev, pagina: 1 }));
    loadLogs();
  };

  const getTipoColor = (tipo: string) => {
    switch (tipo) {
      case 'INFO': return 'bg-blue-100 text-blue-800 border-blue-200';
      case 'WARNING': return 'bg-yellow-100 text-yellow-800 border-yellow-200';
      case 'ERROR': return 'bg-red-100 text-red-800 border-red-200';
      case 'SECURITY': return 'bg-purple-100 text-purple-800 border-purple-200';
      case 'SYSTEM': return 'bg-gray-100 text-gray-800 border-gray-200';
      default: return 'bg-gray-100 text-gray-800 border-gray-200';
    }
  };

  const getCategoriaIcon = (categoria: string) => {
    switch (categoria) {
      case 'AUTH': return '🔐';
      case 'USER': return '👤';
      case 'PERSON': return '👥';
      case 'LOAN': return '📚';
      case 'BOOK': return '📖';
      case 'BACKUP': return '💾';
      case 'CONFIG': return '⚙️';
      case 'SYSTEM': return '🖥️';
      default: return '📋';
    }
  };

  const getRoleColor = (role: string) => {
    switch (role?.toLowerCase()) {
      case 'superadmin': return 'bg-red-100 text-red-800';
      case 'admin': return 'bg-blue-100 text-blue-800';
      case 'user': return 'bg-green-100 text-green-800';
      default: return 'bg-gray-100 text-gray-800';
    }
  };

  const formatUserAgent = (userAgent?: string) => {
    if (!userAgent) return 'Desconocido';
    
    // Extraer información del navegador
    let browser = 'Desconocido';
    let os = 'Desconocido';
    
    if (userAgent.includes('Chrome')) browser = 'Chrome';
    else if (userAgent.includes('Firefox')) browser = 'Firefox';
    else if (userAgent.includes('Safari')) browser = 'Safari';
    else if (userAgent.includes('Edge')) browser = 'Edge';
    
    if (userAgent.includes('Windows')) os = 'Windows';
    else if (userAgent.includes('Mac')) os = 'macOS';
    else if (userAgent.includes('Linux')) os = 'Linux';
    else if (userAgent.includes('Android')) os = 'Android';
    else if (userAgent.includes('iOS')) os = 'iOS';
    
    return `${browser} / ${os}`;
  };

  const exportLogs = () => {
    const csvContent = [
      ['Fecha', 'Tipo', 'Categoría', 'Acción', 'Usuario', 'Rol', 'IP', 'Navegador', 'Descripción'],
      ...logs.map(log => [
        new Date(log.createdAt).toLocaleString(),
        log.tipo,
        log.categoria,
        log.accion,
        log.usuario?.username || log.usuarioNombre || 'Sistema',
        log.usuario?.role || '',
        log.ip || '',
        formatUserAgent(log.userAgent),
        log.descripcion
      ])
    ].map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');
    
    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `logs_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    window.URL.revokeObjectURL(url);
  };

  const getTipoIcon = (tipo: string) => {
    switch (tipo) {
      case 'INFO': return 'ℹ️';
      case 'WARNING': return '⚠️';
      case 'ERROR': return '❌';
      case 'SECURITY': return '🔒';
      case 'SYSTEM': return '⚙️';
      default: return '📝';
    }
  };

  return (
    <MainLayout showSidebar={true}>
    <div className="min-h-screen bg-gray-50">
      
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* Header */}
        <div className="mb-8">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-3xl font-bold text-gray-900">📋 Logs del Sistema</h1>
              <p className="text-gray-600 mt-2">Auditoría completa de actividad del sistema en tiempo real</p>
            </div>
    </MainLayout>
            <div className="flex space-x-3">
              <button
                onClick={exportLogs}
                className="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 flex items-center space-x-2"
              >
                <span>📊</span>
                <span>Exportar CSV</span>
              </button>
              <button
                onClick={() => {
                  loadLogs();
                  loadStats();
                }}
                className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 flex items-center space-x-2"
              >
                <span>🔄</span>
                <span>Actualizar</span>
              </button>
              <button
                onClick={() => window.history.back()}
                className="px-4 py-2 bg-gray-600 text-white rounded-md hover:bg-gray-700"
              >
                ← Volver
              </button>
            </div>
    </MainLayout>
          </div>
    </MainLayout>
        </div>
    </MainLayout>

        {/* Estadísticas */}
        {stats && (
          <div className="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6">
            <div className="bg-white p-4 rounded-lg shadow border-l-4 border-blue-500">
              <div className="text-sm text-gray-600">Total Logs</div>
              <div className="text-2xl font-bold text-blue-600">{stats.total}</div>
            </div>
    </MainLayout>
            {stats.porTipo.map((item: any) => (
              <div key={item._id} className="bg-white p-4 rounded-lg shadow">
                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-xs text-gray-600">{item._id}</div>
                    <div className="text-xl font-bold">{item.count}</div>
                  </div>
    </MainLayout>
                  <span className="text-2xl">{getTipoIcon(item._id)}</span>
                </div>
    </MainLayout>
              </div>
    </MainLayout>
            ))}
          </div>
    </MainLayout>
        )}

        {/* Filtros */}
        <div className="bg-white rounded-lg shadow p-4 mb-6">
          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
              <select
                value={filters.tipo}
                onChange={(e) => setFilters({ ...filters, tipo: e.target.value, pagina: 1 })}
                className="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500"
              >
                <option value="all">Todos</option>
                <option value="INFO">ℹ️ Info</option>
                <option value="WARNING">⚠️ Warning</option>
                <option value="ERROR">❌ Error</option>
                <option value="SECURITY">🔒 Seguridad</option>
                <option value="SYSTEM">⚙️ Sistema</option>
              </select>
            </div>
    </MainLayout>

            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
              <select
                value={filters.categoria}
                onChange={(e) => setFilters({ ...filters, categoria: e.target.value, pagina: 1 })}
                className="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500"
              >
                <option value="all">Todas</option>
                <option value="AUTH">🔐 Autenticación</option>
                <option value="USER">👤 Usuarios</option>
                <option value="PERSON">👥 Personas</option>
                <option value="BOOK">📖 Libros</option>
                <option value="LOAN">📚 Préstamos</option>
                <option value="BACKUP">💾 Backup</option>
                <option value="CONFIG">⚙️ Configuración</option>
                <option value="SYSTEM">🖥️ Sistema</option>
                <option value="SECURITY">🔒 Seguridad</option>
              </select>
            </div>
    </MainLayout>

            <div className="md:col-span-2">
              <label className="block text-sm font-medium text-gray-700 mb-1">Buscar</label>
              <div className="flex space-x-2">
                <input
                  type="text"
                  value={filters.buscar}
                  onChange={(e) => setFilters({ ...filters, buscar: e.target.value })}
                  placeholder="Buscar en logs..."
                  className="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500"
                  onKeyPress={(e) => e.key === 'Enter' && handleSearch()}
                />
                <button
                  onClick={handleSearch}
                  className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
                >
                  🔍 Buscar
                </button>
              </div>
    </MainLayout>
            </div>
    </MainLayout>
          </div>
    </MainLayout>
        </div>
    </MainLayout>

        {/* Tabla de Logs */}
        <div className="bg-white rounded-lg shadow overflow-hidden">
          {loading ? (
            <div className="p-12 text-center">
              <div className="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
              <p className="text-gray-600 mt-4">Cargando logs...</p>
            </div>
    </MainLayout>
          ) : logs.length === 0 ? (
            <div className="p-12 text-center text-gray-500">
              No se encontraron logs
            </div>
    </MainLayout>
          ) : (
            <>
              <div className="overflow-x-auto">
                <table className="min-w-full divide-y divide-gray-200">
                  <thead className="bg-gray-50">
                    <tr>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha/Hora</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Categoría</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acción</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Usuario</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">IP</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Navegador</th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Descripción</th>
                    </tr>
                  </thead>
                  <tbody className="bg-white divide-y divide-gray-200">
                    {logs.map((log) => (
                      <tr key={log._id} className="hover:bg-gray-50 transition-colors">
                        <td className="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">
                          <div className="text-xs text-gray-500">
                            {new Date(log.createdAt).toLocaleDateString()}
                          </div>
    </MainLayout>
                          <div className="font-medium">
                            {new Date(log.createdAt).toLocaleTimeString()}
                          </div>
    </MainLayout>
                        </td>
                        <td className="px-4 py-3 whitespace-nowrap">
                          <span className={`inline-flex items-center px-2 py-1 rounded-full text-xs font-medium border ${getTipoColor(log.tipo)}`}>
                            {getTipoIcon(log.tipo)} {log.tipo}
                          </span>
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-600 whitespace-nowrap">
                          <span className="inline-flex items-center space-x-1">
                            <span>{getCategoriaIcon(log.categoria)}</span>
                            <span>{log.categoria}</span>
                          </span>
                        </td>
                        <td className="px-4 py-3 text-sm font-mono text-gray-800 max-w-xs truncate">
                          {log.accion}
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">
                          <div className="flex flex-col">
                            <span className="font-medium">
                              {log.usuario?.username || log.usuarioNombre || 'Sistema'}
                            </span>
                            {log.usuario?.role && (
                              <span className={`inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium ${getRoleColor(log.usuario.role)}`}>
                                {log.usuario.role}
                              </span>
                            )}
                          </div>
    </MainLayout>
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-600 whitespace-nowrap font-mono">
                          {log.ip || 'N/A'}
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-600 max-w-xs truncate">
                          {formatUserAgent(log.userAgent)}
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-600 max-w-md">
                          <div className="truncate" title={log.descripcion}>
                            {log.descripcion}
                          </div>
    </MainLayout>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
    </MainLayout>

              {/* Paginación */}
              {pagination && pagination.totalPaginas > 1 && (
                <div className="bg-gray-50 px-4 py-3 flex items-center justify-between border-t">
                  <div className="text-sm text-gray-700">
                    Mostrando {((pagination.pagina - 1) * pagination.limite) + 1} - {Math.min(pagination.pagina * pagination.limite, pagination.total)} de {pagination.total}
                  </div>
    </MainLayout>
                  <div className="flex space-x-2">
                    <button
                      onClick={() => setFilters({ ...filters, pagina: filters.pagina - 1 })}
                      disabled={filters.pagina === 1}
                      className="px-3 py-1 border rounded bg-white disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50"
                    >
                      ← Anterior
                    </button>
                    <span className="px-3 py-1">
                      Página {filters.pagina} de {pagination.totalPaginas}
                    </span>
                    <button
                      onClick={() => setFilters({ ...filters, pagina: filters.pagina + 1 })}
                      disabled={filters.pagina === pagination.totalPaginas}
                      className="px-3 py-1 border rounded bg-white disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50"
                    >
                      Siguiente →
                    </button>
                  </div>
    </MainLayout>
                </div>
    </MainLayout>
              )}
            </>
          )}
        </div>
    </MainLayout>
      </div>
    </MainLayout>
    </div>
    </MainLayout>
  );
};

export default SystemLogsPage;
