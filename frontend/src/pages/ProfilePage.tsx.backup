import React, { useState } from 'react';
import { useUserData } from '../hooks/useUserData';
import MainLayout from '../components/MainLayout';
import Avatar from '../components/Avatar';

interface ProfileFieldState {
  telefono: string;
  email: string;
  direccion: string;
}

const ProfilePage: React.FC = () => {
  const { user, person, loading, error, refreshUserData } = useUserData();
  const [fields, setFields] = useState<ProfileFieldState>({ 
    telefono: '', 
    email: '', 
    direccion: '' 
  });
  const [saving, setSaving] = useState(false);
  const [msg, setMsg] = useState<{type:'success'|'error'|'info', text:string}|null>(null);
  const [uploadingImage, setUploadingImage] = useState(false);

  // Actualizar campos cuando cambie la persona
  React.useEffect(() => {
    if (person) {
      setFields({
        telefono: person.telefono || person.phone || '',
        email: person.email || '',
        direccion: person.direccion || person.address || ''
      });
    }
  }, [person]);

  const handleSave = async () => {
    if (!person?._id) {
      setMsg({type:'error', text:'No se encontró la persona asociada.'});
      return;
    }
    
    try {
      setSaving(true);
      
      const response = await fetch(`http://localhost:5000/api/persons/${person._id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${localStorage.getItem('token')}`
        },
        body: JSON.stringify({
          telefono: fields.telefono,
          email: fields.email,
          direccion: fields.direccion
        })
      });
      
      const data = await response.json();
      
      if (data.success) {
        // Actualizar los datos del usuario
        await refreshUserData();
        setMsg({type:'success', text:'Perfil actualizado correctamente.'});
      } else {
        setMsg({type:'error', text: data.message || 'No se pudo actualizar el perfil.'});
      }
    } catch (error) {
      console.error('Error al guardar el perfil:', error);
      setMsg({type:'error', text:'Error de conexión al guardar. Por favor, inténtalo de nuevo.'});
    } finally {
      setSaving(false);
    }
  };

  const handleImageUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;

    // Validar que sea una imagen
    if (!file.type.startsWith('image/')) {
      setMsg({type:'error', text:'Solo se permiten archivos de imagen'});
      return;
    }

    // Validar tamaño (máximo 5MB)
    if (file.size > 5 * 1024 * 1024) {
      setMsg({type:'error', text:'La imagen no puede ser mayor a 5MB'});
      return;
    }

    try {
      setUploadingImage(true);
      setMsg(null);

      const formData = new FormData();
      formData.append('profileImage', file);

      const token = localStorage.getItem('token');
      const response = await fetch(`http://localhost:5000/api/users/${user?._id}/profile-image`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`
        },
        body: formData
      });

      const data = await response.json();

      if (data.success) {
        setMsg({type:'success', text:'Imagen de perfil actualizada exitosamente'});
        // Refrescar datos del usuario para mostrar la nueva imagen
        await refreshUserData();
        // Forzar re-render del componente con un pequeño delay
        setTimeout(() => {
          window.location.reload();
        }, 500);
      } else {
        setMsg({type:'error', text:data.message || 'Error al actualizar la imagen'});
      }
    } catch (error) {
      console.error('Error al subir imagen:', error);
      setMsg({type:'error', text:'Error al actualizar la imagen de perfil'});
    } finally {
      setUploadingImage(false);
    }
  };

  if (loading) return (
    
    <div className="min-h-screen bg-gray-50 flex items-center justify-center">
      <div className="text-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
        <p className="mt-4 text-gray-600">Cargando perfil...</p>
      </div>
    
    </div>
    
  );

  if (error) {
    return (
    
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="text-center">
          <div className="text-red-500 text-xl mb-4">❌</div>
          <p className="text-red-600 mb-4">{error}</p>
          <button
            onClick={refreshUserData}
            className="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md"
          >
            Reintentar
          </button>
        </div>
    
      </div>
    
    );
  }

  return (
    <MainLayout title="Mi Perfil">
      <div className="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div className="bg-white rounded-lg shadow p-6 space-y-6">
          {/* Avatar y Upload */}
          <div className="flex flex-col items-center pb-6 border-b">
            <div className="mb-4">
              <Avatar 
                user={user}
                size="lg"
                className="ring-4 ring-gray-200"
              />
            </div>
            <div className="relative">
              <input
                type="file"
                id="profile-image-upload"
                accept="image/*"
                onChange={handleImageUpload}
                className="hidden"
                disabled={uploadingImage}
              />
              <label
                htmlFor="profile-image-upload"
                className="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {uploadingImage ? (
                  <>
                    <svg className="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                      <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Subiendo...
                  </>
                ) : (
                  <>
                    <svg className="-ml-1 mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                    Cambiar Foto
                  </>
                )}
              </label>
            </div>
            <p className="text-xs text-gray-500 mt-2">JPG, PNG o GIF. Máximo 5MB</p>
          </div>
          {/* Información del Usuario */}
          <div className="border-b pb-6">
            <h2 className="text-lg font-semibold text-gray-900 mb-4">🔐 Información de Usuario</h2>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Nombre de Usuario</label>
                <input disabled value={user?.username || ''} className="w-full px-3 py-2 border rounded bg-gray-100" />
              </div>
    
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Rol</label>
                <input disabled value={user?.role || ''} className="w-full px-3 py-2 border rounded bg-gray-100 capitalize" />
              </div>
    
            </div>
    
          </div>

          {/* Información Personal */}
          <div className="border-b pb-6">
            <h2 className="text-lg font-semibold text-gray-900 mb-4">👤 Información Personal</h2>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Nombre Completo</label>
                <input disabled value={person ? (person.nombreCompleto || `${person.nombre1 || ''} ${person.apellido1 || ''}`.trim()) : ''} className="w-full px-3 py-2 border rounded bg-gray-100" />
              </div>
    
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Tipo de Documento</label>
                <input disabled value={person?.tipoDoc || ''} className="w-full px-3 py-2 border rounded bg-gray-100" />
              </div>
    
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Número de Documento</label>
                <input disabled value={person?.doc || ''} className="w-full px-3 py-2 border rounded bg-gray-100" />
              </div>
    
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Grado/Curso</label>
                <input disabled value={person?.grado || ''} className="w-full px-3 py-2 border rounded bg-gray-100" />
              </div>
    
            </div>
    
          </div>

          {/* Información de Contacto (Editable) */}
          <div>
            <h2 className="text-lg font-semibold text-gray-900 mb-4">📞 Información de Contacto</h2>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
                <input 
                  value={fields.telefono} 
                  onChange={e=>setFields({...fields, telefono:e.target.value})} 
                  className="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                  placeholder="Ingrese su teléfono"
                />
              </div>
    
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico</label>
                <input 
                  type="email"
                  value={fields.email} 
                  onChange={e=>setFields({...fields, email:e.target.value})} 
                  className="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                  placeholder="correo@ejemplo.com"
                />
              </div>
    
            </div>

            <div className="mt-4">
              <label className="block text-sm font-medium text-gray-700 mb-1">Dirección</label>
              <input 
                value={fields.direccion} 
                onChange={e=>setFields({...fields, direccion:e.target.value})} 
                className="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                placeholder="Ingrese su dirección"
              />
            </div>
    
          </div>

          {/* Mensajes de estado */}
          {msg && (
            <div className={`p-3 rounded border-l-4 ${
              msg.type==='success'?'bg-green-50 border-green-500 text-green-700':
              msg.type==='error'?'bg-red-50 border-red-500 text-red-700':
              'bg-blue-50 border-blue-500 text-blue-700'
            }`}>
              {msg.text}
            </div>
          )}

          <div className="pt-4 flex justify-end space-x-3">
            <button 
              onClick={refreshUserData} 
              disabled={saving}
              className="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 disabled:bg-gray-400"
            >
              🔄 Actualizar Datos
            </button>
            <button 
              onClick={handleSave} 
              disabled={saving} 
              className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 disabled:bg-gray-400"
            >
              {saving ? '💾 Guardando...' : '💾 Guardar Cambios'}
            </button>
          </div>
        </div>
      </div>
    </MainLayout>
    
  );
};

export default ProfilePage;
