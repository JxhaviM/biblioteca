import React, { useState, useEffect } from 'react';
import type { Dispatch, SetStateAction } from 'react';
import CreateLoanModal from '../components/CreateLoanModal';
import type { User, Person } from '../api/auth';

interface LoansPageProps {
  user: User | null;
  person: Person | null;
  setUser: Dispatch<SetStateAction<User | null>>;
  setPerson: Dispatch<SetStateAction<Person | null>>;
}

interface Loan {
  _id: string;
  bookId: {
    _id: string;
    title: string;
    author: string;
    isbn: string;
    coverImage?: string;
  };
  studentId: {
    _id: string;
    name: string;
    idNumber: string;
    grade: string;
  };
  loanDate: string;
  dueDate: string;
  returnDate?: string;
  status: 'borrowed' | 'returned' | 'overdue';
  notes?: string;
}

const LoansPage: React.FC<LoansPageProps> = ({ user, person, setUser, setPerson }) => {
  const [activeTab, setActiveTab] = useState<'pending' | 'active' | 'history'>('active');
  const [loans, setLoans] = useState<Loan[]>([]);
  const [loading, setLoading] = useState(false);
  const [searchTerm, setSearchTerm] = useState('');
  const [showCreateModal, setShowCreateModal] = useState(false);
  const [studentModal, setStudentModal] = useState<{open: boolean, person: any | null, loading?: boolean}>({open: false, person: null, loading: false});

  useEffect(() => {
    fetchLoans();
  }, [activeTab]);

  const fetchLoans = async () => {
    setLoading(true);
    try {
      const token = localStorage.getItem('token');
      const isAdmin = user && (user.role === 'admin' || user.role === 'superadmin');

      let url = '';
      if (isAdmin) {
        const statusParam = activeTab === 'pending' ? 'pendiente' : (activeTab === 'active' ? 'prestado,atrasado' : 'devuelto');
        url = `http://localhost:5000/api/loans?status=${encodeURIComponent(statusParam)}&_t=${Date.now()}`;
      } else if (user) {
        const statusParam = activeTab === 'active' ? 'prestado,atrasado' : (activeTab === 'history' ? 'devuelto' : 'pendiente');
        url = `http://localhost:5000/api/loans/user/${user.id}?status=${encodeURIComponent(statusParam)}&_t=${Date.now()}`;
      }

      const response = await fetch(url, {
        headers: {
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
          'Cache-Control': 'no-cache'
        }
      });
      
      const data = await response.json();
      if (data.success) {
        if (isAdmin) {
          setLoans(data.data || []);
        } else {
          // Usuario normal: la API devuelve { data: { user, person, loans } }
          const pack = data.data || {};
          const personInfo = pack.person || {};
          const loansArr = Array.isArray(pack.loans) ? pack.loans : [];
          // Adjuntar studentId con info de persona para que UI lo muestre
          const mapped = loansArr.map((l: any) => ({
            ...l,
            studentId: {
              _id: personInfo._id || (pack.user && pack.user._id) || '',
              name: personInfo.nombreCompleto || [personInfo.apellido1, personInfo.nombre1].filter(Boolean).join(' ') || personInfo.name || 'N/A',
              idNumber: personInfo.doc || personInfo.idNumber || 'N/A',
              grade: personInfo.grado || personInfo.grade || 'N/A'
            }
          }));
          setLoans(mapped);
        }
      }
    } catch (error) {
      console.error('Error fetching loans:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleReturn = async (loanId: string) => {
    if (!confirm('¿Confirmar devolución de este libro?')) return;
    
    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`http://localhost:5000/api/loans/${loanId}/return`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          ...(token ? { Authorization: `Bearer ${token}` } : {})
        }
      });
      
      const data = await response.json();
      if (data.success) {
        alert('✅ Libro devuelto exitosamente');
        fetchLoans();
      } else {
        alert('❌ Error: ' + data.message);
      }
    } catch (error) {
      console.error('Error returning book:', error);
      alert('❌ Error al devolver el libro');
    }
  };

  const handleApprove = async (loanId: string) => {
    if (!confirm('¿Aprobar esta solicitud de préstamo?')) return;
    try {
      const token = localStorage.getItem('token');
      const resp = await fetch(`http://localhost:5000/api/loans/${loanId}/approve`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          ...(token ? { Authorization: `Bearer ${token}` } : {})
        }
      });
      const data = await resp.json();
      if (data.success) {
        alert('✅ Solicitud aprobada');
        fetchLoans();
      } else {
        alert('❌ ' + (data.message || 'No se pudo aprobar'));
      }
    } catch (e) {
      console.error(e);
      alert('❌ Error de conexión al aprobar');
    }
  };

  const handleReject = async (loanId: string) => {
    const reason = prompt('Motivo del rechazo (opcional):') || '';
    try {
      const token = localStorage.getItem('token');
      const resp = await fetch(`http://localhost:5000/api/loans/${loanId}/reject`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          ...(token ? { Authorization: `Bearer ${token}` } : {})
        },
        body: JSON.stringify({ reason })
      });
      const data = await resp.json();
      if (data.success) {
        alert('✅ Solicitud rechazada');
        fetchLoans();
      } else {
        alert('❌ ' + (data.message || 'No se pudo rechazar'));
      }
    } catch (e) {
      console.error(e);
      alert('❌ Error de conexión al rechazar');
    }
  };

  const filteredLoans = loans.filter(loan => {
    if (!searchTerm) return true;
    const search = searchTerm.toLowerCase();
    return (
    <MainLayout showSidebar={true}>
      loan.bookId?.title?.toLowerCase().includes(search) ||
      loan.bookId?.author?.toLowerCase().includes(search) ||
      (getStudentInfo(loan).name || '').toLowerCase().includes(search) ||
      (getStudentInfo(loan).idNumber || '').toLowerCase().includes(search)
    );
  });

  const getStatusBadge = (status: string, dueDate: string) => {
    const normalized = (status || '').toLowerCase();
    const isOverdue = new Date(dueDate) < new Date() && (normalized === 'prestado' || normalized === 'borrowed');
    if (normalized === 'devuelto' || normalized === 'returned') {
      return <span className="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Devuelto</span>;
    }
    if (normalized === 'pendiente' || normalized === 'pending') {
      return <span className="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pendiente</span>;
    }
    if (isOverdue || normalized === 'atrasado' || normalized === 'overdue') {
      return <span className="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Retrasado</span>;
    }
    return <span className="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Activo</span>;
  };

  function getStudentInfo(loan: any) {
    // Try multiple shapes: loan.persona, loan.studentId, loan.user?.person
    const p = loan.persona || loan.studentId || loan.person || loan.user?.person || loan.user?.persona || {};
    const name = p.nombre || p.nombreCompleto || p.name || [p.apellido1, p.nombre1].filter(Boolean).join(' ') || 'N/A';
    const idNumber = p.doc || p.idNumber || 'N/A';
    const grade = p.grado || p.grade || 'N/A';
    return { name, idNumber, grade, raw: p };
  }

  const openStudentModal = async (raw: any) => {
    const id = raw?._id || raw?.id;
    if (!id) {
      setStudentModal({open: true, person: raw || {}, loading: false});
      return;
    }
    try {
      setStudentModal({open: true, person: null, loading: true});
      const token = localStorage.getItem('token');
      const resp = await fetch(`http://localhost:5000/api/persons/${id}?_t=${Date.now()}`, {
        headers: { 'Authorization': token ? `Bearer ${token}` : '' }
      });
      const data = await resp.json();
      if (data && data.success) {
        setStudentModal({open: true, person: data.data || data.person || data, loading: false});
      } else {
        setStudentModal({open: true, person: raw || {}, loading: false});
      }
    } catch (e) {
      console.error('Fetch person error:', e);
      setStudentModal({open: true, person: raw || {}, loading: false});
    }
  };

  return (
    <MainLayout showSidebar={true}>
    <div className="min-h-screen bg-gray-50">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* Header */}
        <div className="mb-8">
          <h1 className="text-3xl font-bold text-gray-900 flex items-center gap-2">
            <svg className="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Gestión de Préstamos
          </h1>
          <p className="mt-2 text-gray-600">Administra los préstamos y devoluciones de libros</p>
        </div>
    </MainLayout>

        {/* Tabs */}
        <div className="mb-6 border-b border-gray-200">
          <div className="flex gap-4">
            {(user && (user.role === 'admin' || user.role === 'superadmin')) && (
              <button
                onClick={() => setActiveTab('pending')}
                className={`pb-3 px-1 border-b-2 font-medium text-sm transition-colors ${
                  activeTab === 'pending'
                    ? 'border-yellow-500 text-yellow-600'
                    : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
                }`}
              >
                🟡 Pendientes
              </button>
            )}
            <button
              onClick={() => setActiveTab('active')}
              className={`pb-3 px-1 border-b-2 font-medium text-sm transition-colors ${
                activeTab === 'active'
                  ? 'border-blue-500 text-blue-600'
                  : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
              }`}
            >
              📚 Préstamos Activos
            </button>
            <button
              onClick={() => setActiveTab('history')}
              className={`pb-3 px-1 border-b-2 font-medium text-sm transition-colors ${
                activeTab === 'history'
                  ? 'border-blue-500 text-blue-600'
                  : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
              }`}
            >
              📋 Historial
            </button>
          </div>
    </MainLayout>
        </div>
    </MainLayout>

        {/* Actions Bar */}
        <div className="mb-6 flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
          <div className="relative flex-1 max-w-md">
            <input
              type="text"
              placeholder="Buscar por libro, estudiante o ID..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <svg className="absolute left-3 top-2.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
    </MainLayout>
          
          <button
            onClick={() => setShowCreateModal(true)}
            className="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-md"
          >
            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4v16m8-8H4" />
            </svg>
            Nuevo Préstamo
          </button>
        </div>
    </MainLayout>

        {/* Loans Table */}
        <div className="bg-white shadow-lg rounded-lg overflow-hidden">
          {loading ? (
            <div className="flex items-center justify-center py-12">
              <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
              <span className="ml-2 text-gray-600">Cargando préstamos...</span>
            </div>
    </MainLayout>
          ) : filteredLoans.length === 0 ? (
            <div className="text-center py-12">
              <svg className="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              <p className="text-lg font-medium text-gray-400">No hay préstamos</p>
              <p className="text-sm text-gray-400 mt-1">
                {activeTab === 'active' ? 'No hay préstamos activos en este momento' : 'No hay historial de préstamos'}
              </p>
            </div>
    </MainLayout>
          ) : (
            <div className="overflow-x-auto">
              <table className="min-w-full divide-y divide-gray-200">
                <thead className="bg-gray-50">
                  <tr>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Libro</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Estudiante</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fecha Préstamo</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fecha Devolución</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Estado</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Acciones</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {filteredLoans.map((loan) => (
                    <tr key={loan._id} className="hover:bg-gray-50">
                      <td className="px-6 py-4">
                        <div className="flex items-center gap-3">
                          {loan.bookId?.coverImage ? (
                            <img 
                              src={`http://localhost:5000${loan.bookId.coverImage}`}
                              alt={loan.bookId?.title}
                              className="w-10 h-14 object-cover rounded"
                            />
                          ) : (
                            <div className="w-10 h-14 bg-gray-100 rounded flex items-center justify-center">
                              <svg className="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                              </svg>
                            </div>
    </MainLayout>
                          )}
                          <div>
                            <p className="text-sm font-medium text-gray-900">{loan.bookId?.title || 'N/A'}</p>
                            <p className="text-xs text-gray-500">{loan.bookId?.author || 'N/A'}</p>
                          </div>
    </MainLayout>
                        </div>
    </MainLayout>
                      </td>
                      <td className="px-6 py-4">
                        {(() => {
                          const s = getStudentInfo(loan);
                          return (
    <MainLayout showSidebar={true}>
                            <button
                              type="button"
                              onClick={() => openStudentModal(s.raw)}
                              className="text-left hover:underline"
                            >
                              <p className="text-sm font-medium text-gray-900">{s.name}</p>
                              <p className="text-xs text-gray-500">ID: {s.idNumber}</p>
                              <p className="text-xs text-gray-500">Grado: {s.grade}</p>
                            </button>
                          );
                        })()}
                      </td>
                      <td className="px-6 py-4 text-sm text-gray-500">
                        {new Date(loan.loanDate).toLocaleDateString('es-CO')}
                      </td>
                      <td className="px-6 py-4 text-sm text-gray-500">
                        {loan.returnDate 
                          ? new Date(loan.returnDate).toLocaleDateString('es-CO')
                          : new Date(loan.dueDate).toLocaleDateString('es-CO')
                        }
                      </td>
                      <td className="px-6 py-4">
                        {getStatusBadge((loan as any).status, (loan as any).dueDate)}
                      </td>
                      <td className="px-6 py-4 flex gap-2">
                        {((loan as any).status === 'prestado' || (loan as any).status === 'borrowed') && (
                          <button
                            onClick={() => handleReturn(loan._id)}
                            className="px-3 py-1 bg-green-600 text-white text-sm rounded hover:bg-green-700 transition-colors"
                          >
                            Devolver
                          </button>
                        )}
                        {(user && (user.role === 'admin' || user.role === 'superadmin') && ((loan as any).status === 'pendiente' || (loan as any).status === 'pending')) && (
                          <>
                            <button
                              onClick={() => handleApprove(loan._id)}
                              className="px-3 py-1 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition-colors"
                            >
                              Aprobar
                            </button>
                            <button
                              onClick={() => handleReject(loan._id)}
                              className="px-3 py-1 bg-red-600 text-white text-sm rounded hover:bg-red-700 transition-colors"
                            >
                              Rechazar
                            </button>
                          </>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
    </MainLayout>
          )}
        </div>
    </MainLayout>

        {/* Stats Cards */}
        <div className="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div className="bg-white p-6 rounded-lg shadow">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Préstamos Activos</p>
                <p className="text-2xl font-bold text-blue-600">
                  {loans.filter(l => l.status === 'borrowed').length}
                </p>
              </div>
    </MainLayout>
              <div className="bg-blue-100 p-3 rounded-full">
                <svg className="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
    </MainLayout>
            </div>
    </MainLayout>
          </div>
    </MainLayout>

          <div className="bg-white p-6 rounded-lg shadow">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Retrasados</p>
                <p className="text-2xl font-bold text-red-600">
                  {loans.filter(l => l.status === 'borrowed' && new Date(l.dueDate) < new Date()).length}
                </p>
              </div>
    </MainLayout>
              <div className="bg-red-100 p-3 rounded-full">
                <svg className="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
    </MainLayout>
            </div>
    </MainLayout>
          </div>
    </MainLayout>

          <div className="bg-white p-6 rounded-lg shadow">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Devueltos Hoy</p>
                <p className="text-2xl font-bold text-green-600">
                  {loans.filter(l => {
                    if (!l.returnDate) return false;
                    const today = new Date().toDateString();
                    return new Date(l.returnDate).toDateString() === today;
                  }).length}
                </p>
              </div>
    </MainLayout>
              <div className="bg-green-100 p-3 rounded-full">
                <svg className="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
    </MainLayout>
            </div>
    </MainLayout>
          </div>
    </MainLayout>
        </div>
    </MainLayout>
      </div>
    </MainLayout>

      {/* Create Loan Modal */}
      <CreateLoanModal
        isOpen={showCreateModal}
        onClose={() => setShowCreateModal(false)}
        onSuccess={fetchLoans}
      />

      {/* Student Details Modal */}
      {studentModal.open && (
        <div className="fixed inset-0 bg-black bg-opacity-30 flex items-center justify-center z-50">
          <div className="bg-white rounded-lg shadow-lg w-full max-w-md p-6">
            <div className="flex justify-between items-center mb-4">
              <h3 className="text-lg font-semibold">Datos del Estudiante</h3>
              <button onClick={() => setStudentModal({open:false, person:null})} className="text-gray-500 hover:text-gray-700">✕</button>
            </div>
    </MainLayout>
            {studentModal.loading ? (
              <div className="py-6 text-center text-gray-500">Cargando datos...</div>
            ) : (() => {
              const p = studentModal.person || {};
              const nombre = p.nombre || p.nombreCompleto || [p.apellido1, p.nombre1].filter(Boolean).join(' ');
              return (
    <MainLayout showSidebar={true}>
                <div className="space-y-2 text-sm">
                  <p><strong>Nombre:</strong> {nombre || 'N/A'}</p>
                  <p><strong>Documento:</strong> {p.doc || p.idNumber || 'N/A'}</p>
                  <p><strong>Grado:</strong> {p.grado || 'N/A'}</p>
                  <p><strong>Grupo:</strong> {p.grupo || 'N/A'}</p>
                  <p><strong>Teléfono:</strong> {p.telefono || p.phone || 'N/A'}</p>
                  <p><strong>Correo:</strong> {p.email || p.correo || 'N/A'}</p>
                  <p><strong>Dirección:</strong> {p.direccion || p.address || 'N/A'}</p>
                </div>
    </MainLayout>
              );
            })()}
          </div>
    </MainLayout>
        </div>
    </MainLayout>
      )}
    </div>
    </MainLayout>
  );
};

export default LoansPage;
