import React, { useState, useEffect } from 'react';
import SidebarWrapper from './SidebarWrapper';
import ChangePasswordModal from './ChangePasswordModal';
import GoogleMap from './GoogleMap';
import Avatar from './Avatar';
import { useAuth } from '../hooks/useAuth';
import { useUserContext } from '../contexts/UserContext';
import { useConfig } from '../hooks/useConfig';

interface MainLayoutProps {
  children: React.ReactNode;
  showSidebar?: boolean;
  title?: string;
  onLoginClick?: () => void;
}

const MainLayout: React.FC<MainLayoutProps> = ({ 
  children, 
  showSidebar = true, 
  title = "BiblioTech",
  onLoginClick
}) => {
  const { user, setUser, setPerson } = useUserContext();
  const { logout } = useAuth({ setUser, setPerson });
  const { config } = useConfig();
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);
  const [isSidebarCollapsed, setIsSidebarCollapsed] = useState(false);
  const [isChangePasswordModalOpen, setIsChangePasswordModalOpen] = useState(false);

  // Función para renderizar el footer dinámico
  const renderFooter = () => {
    // Obtener configuración del footer (dinámica)
    const footerConfig = config?.footer;
    const desarrolladoPor = footerConfig?.desarrolladoPor || '1102 PROM 2025';
    const anio = footerConfig?.anio || '2025';
    const institucion = footerConfig?.institucion || 'I.E. San Pedro Claver';
    const logo = footerConfig?.logo || '';
    const mostrarLogo = footerConfig?.mostrarLogo !== false;

    // Si hay usuario autenticado, mostrar footer simple pero con configuración dinámica
    if (user) {
      return (
        <footer className="bg-gray-800 text-white py-4">
          <div className="text-center text-sm">
            BiblioTech v1. | Desarrollado por {desarrolladoPor} | &copy; {anio} {institucion}
          </div>
        </footer>
      );
    }

    // Si no hay usuario, mostrar footer completo
    return (
      <footer className="bg-gray-800 text-white py-8">
        <div className="container mx-auto px-4">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
            {/* Logo/Institución */}
            <div>
              <h3 className="text-lg font-semibold mb-4">Acerca de</h3>
              {mostrarLogo && logo ? (
                <img src={logo} alt="Logo" className="h-12 mb-3" />
              ) : mostrarLogo ? (
                <div className="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold text-xl mb-3">
                  BT
                </div>
              ) : null}
              <p className="text-sm text-gray-300">
                Sistema de gestión de biblioteca moderno y eficiente para la {institucion}
              </p>
            </div>
            
            {/* Contacto */}
            <div>
              <h3 className="text-lg font-semibold mb-4">Contacto</h3>
              <p className="text-sm text-gray-300 mb-2">📍 Puerto Boyacá, Boyacá</p>
              <p className="text-sm text-gray-300 mb-2">📞 (8) 123 45 67</p>
              <p className="text-sm text-gray-300">📧 biblioteca@spc.edu.co</p>
            </div>
            
            {/* Ubicación */}
            <div>
              <h3 className="text-lg font-semibold mb-4">Ubicación</h3>
              <GoogleMap 
                address="Institución Educativa San Pedro Claver, Puerto Boyacá, Boyacá, Colombia"
              />
            </div>
          </div>
          
          {/* Copyright */}
          <div className="border-t border-gray-700 mt-8 pt-8 text-center text-sm text-gray-400">
            BiblioTech v1. | Desarrollado por {desarrolladoPor} | © {anio} {institucion}
          </div>
        </div>
      </footer>
    );
  };

  // Si no hay usuario o no se muestra sidebar, mostrar contenido simple
  if (!user || !showSidebar) {
    return (
      <div className="min-h-screen bg-gray-50 flex flex-col">
        {/* Header simple - EL ÚNICO HEADER */}
        <header className="bg-white border-b border-gray-200 shadow-sm">
          <div className="px-4 py-3 flex items-center justify-between">
            <div className="flex items-center space-x-3">
              <div className="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
                <span className="text-white font-bold text-sm">BT</span>
              </div>
              <div className="flex items-center">
                <span className="text-xl font-bold text-gray-900">BiblioTech</span>
                <span className="text-sm text-gray-600 ml-2">por </span>
                <a 
                  href="https://spc.edu.co/" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="text-sm text-blue-600 hover:text-blue-800 ml-1 underline"
                >
                  Institución Educativa San Pedro Claver
                </a>
              </div>
            </div>
            
            {/* Botón de iniciar sesión - FUNCIONAL */}
            {!user ? (
              <button
                onClick={onLoginClick}
                className="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition-colors font-medium"
              >
                Iniciar Sesión
              </button>
            ) : (
              /* Account Menu para usuarios sin sidebar */
              <div className="relative group">
                <button className="flex items-center space-x-2 text-sm text-gray-700 hover:text-gray-900 px-3 py-2 rounded-lg hover:bg-gray-100 transition-colors">
                  <Avatar 
                    user={user}
                    size="sm"
                    className="flex-shrink-0"
                  />
                  <span>{user.username}</span>
                  <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                
                {/* Account Menu Dropdown */}
                <div className="absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  <div className="py-1">
                    <a
                      href="/profile"
                      className="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                    >
                      <span className="mr-3">👤</span>
                      Mi Perfil
                    </a>
                    <button
                      onClick={() => setIsChangePasswordModalOpen(true)}
                      className="flex items-center w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                    >
                      <span className="mr-3">🔑</span>
                      Cambiar Contraseña
                    </button>
                    <hr className="my-1" />
                    <button
                      onClick={logout}
                      className="flex items-center w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100 hover:text-red-700"
                    >
                      <span className="mr-3">🚪</span>
                      Cerrar Sesión
                    </button>
                  </div>
                </div>
              </div>
            )}
          </div>
        </header>

        {/* Main Content */}
        <main className="flex-1">
          {children}
        </main>

        {/* Footer */}
        <div className="mt-auto">
          {renderFooter()}
        </div>
      </div>
    );
  }

  // Solo ejecutar este return si hay usuario y showSidebar es true
  if (user && showSidebar) {
    return (
      <div className="h-screen bg-gray-50 flex flex-col overflow-hidden">
        {/* Header sin menú hamburguesa */}
        <header className="bg-white border-b border-gray-200 shadow-sm flex-shrink-0 z-40">
        <div className="px-4 py-3 flex items-center justify-between">
          <div className="flex items-center space-x-2">
            {/* Logo y nombre */}
            <div className="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
              <span className="text-white font-bold text-sm">BT</span>
            </div>
            <div className="flex items-center">
              <span className="text-xl font-bold text-gray-900">BiblioTech</span>
              <span className="text-sm text-gray-600 ml-2">por </span>
              <a 
                href="https://spc.edu.co/" 
                target="_blank" 
                rel="noopener noreferrer"
                className="text-sm text-blue-600 hover:text-blue-800 ml-1 underline"
              >
                Institución Educativa San Pedro Claver
              </a>
            </div>
          </div>

          {/* Espacio para elementos del lado derecho - Account Menu */}
          <div className="flex items-center space-x-3">
            {user ? (
              <div className="relative group">
                <button className="flex items-center space-x-2 text-sm text-gray-700 hover:text-gray-900 px-3 py-2 rounded-lg hover:bg-gray-100 transition-colors">
                  <Avatar 
                    user={user}
                    size="sm"
                    className="flex-shrink-0"
                  />
                  <span>{user.username}</span>
                  <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                
                {/* Account Menu Dropdown Completo */}
                <div className="absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  <div className="py-1">
                    <a
                      href="/profile"
                      className="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                    >
                      <span className="mr-3">👤</span>
                      Mi Perfil
                    </a>
                    <button
                      onClick={() => setIsChangePasswordModalOpen(true)}
                      className="flex items-center w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                    >
                      <span className="mr-3">🔑</span>
                      Cambiar Contraseña
                    </button>
                    <div className="border-t border-gray-100"></div>
                    <button
                      onClick={() => {
                        localStorage.removeItem('token');
                        localStorage.removeItem('user');
                        localStorage.removeItem('person');
                        window.location.href = '/';
                      }}
                      className="flex items-center w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                    >
                      <span className="mr-3">🚪</span>
                      Cerrar Sesión
                    </button>
                  </div>
                </div>
              </div>
            ) : (
              <button
                onClick={onLoginClick}
                className="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition-colors font-medium"
              >
                Iniciar Sesión
              </button>
            )}
          </div>
        </div>
      </header>

      <div className="flex flex-1 overflow-hidden">
        {/* Sidebar - comienza debajo del header */}
        <div className={`${isSidebarCollapsed ? 'w-16' : 'w-64'} bg-white shadow-lg flex-shrink-0 transition-all duration-300 overflow-hidden flex flex-col`}>
          <SidebarWrapper onCollapseChange={setIsSidebarCollapsed} />
        </div>

        {/* Main Content */}
        <div className="flex-1 flex flex-col overflow-hidden">
          <main className="flex-1 overflow-y-auto">
            <div className="p-6">
              {children}
            </div>
          </main>

          {/* Footer fijo al final */}
          <div className="flex-shrink-0">
            {renderFooter()}
          </div>
        </div>
      </div>
    
    {/* Modal de Cambiar Contraseña */}
    {isChangePasswordModalOpen && user && (
      <ChangePasswordModal
        isOpen={isChangePasswordModalOpen}
        onClose={() => setIsChangePasswordModalOpen(false)}
        username={user.username}
      />
    )}
    </div>
    );
  }

  // Si no hay condiciones anteriores, no renderizar nada
  return null;
};

export default MainLayout;
