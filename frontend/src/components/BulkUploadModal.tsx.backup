import React, { useState, useRef } from 'react';
import { uploadPersonsBulk } from '../api/persons';
import type { ApiResponse } from '../types';

type BulkResponse = ApiResponse<Record<string, unknown>> & { jobId?: string };

interface BulkUploadModalProps {
  isOpen: boolean;
  onClose: () => void;
  onUploaded?: () => void;
}

const BulkUploadModal: React.FC<BulkUploadModalProps> = ({ isOpen, onClose, onUploaded }) => {
  const [file, setFile] = useState<File | null>(null);
  const [previewRows, setPreviewRows] = useState<string[][]>([]);
  const [loading, setLoading] = useState(false);
  const [jobId, setJobId] = useState<string | null>(null);
  const [jobStatus, setJobStatus] = useState<string | null>(null);
  const [tipoPersona, setTipoPersona] = useState<'Estudiante' | 'Profesor' | 'Colaborador' | 'Publico' | ''>('');
  const cancelPollingRef = useRef(false);

  const resetState = () => {
    setFile(null);
    setPreviewRows([]);
    setLoading(false);
    setJobId(null);
    setJobStatus(null);
    setTipoPersona('');
    cancelPollingRef.current = true;
  };

  const handleClose = () => {
    resetState();
    onClose();
  };

  if (!isOpen) return null;

  const handleFile = (f?: File) => {
    if (!f) {
      setFile(null);
      setPreviewRows([]);
      return;
    }

    setFile(f);

    // If the file is Excel, try to parse it in the client for preview (lazy-load xlsx)
    const name = f.name.toLowerCase();
    if (name.endsWith('.xls') || name.endsWith('.xlsx')) {
      setPreviewRows([]);
      // lazy-load xlsx
      import('xlsx').then((XLSX) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const data = e.target?.result;
          try {
            const workbook = XLSX.read(data, { type: 'binary' });
            const sheetName = workbook.SheetNames[0];
            const sheet = workbook.Sheets[sheetName];
            const jsonRows = XLSX.utils.sheet_to_json<string[]>(sheet, { header: 1, defval: '' }) as string[][];
            const rows = jsonRows.slice(0, 5).map(r => r.map(cell => String(cell).trim()));
            setPreviewRows(rows as string[][]);
          } catch (err) {
            console.error('Error parsing excel preview', err);
            setPreviewRows([]);
          }
        };
        reader.readAsBinaryString(f);
      }).catch(err => {
        console.error('Failed to load xlsx for preview', err);
        setPreviewRows([]);
      });
      return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const text = String(e.target?.result || '');
      const lines = text.split(/\r?\n/).filter(Boolean);
      const rows = lines.slice(0, 5).map(l => l.split(',').map(cell => cell.trim()));
      setPreviewRows(rows);
    };
    reader.readAsText(f);
  };

  const handleSubmit = async () => {
    if (!tipoPersona) return alert('Seleccione primero el tipo de persona');
    if (!file) return alert('Seleccione un archivo CSV o Excel');
    setLoading(true);
    try {
      const res = await uploadPersonsBulk(file, tipoPersona);
      const data = res as BulkResponse;
      if (data.success && data.jobId) {
  setJobId(data.jobId);
  setJobStatus('queued');
  cancelPollingRef.current = false;
  // empezar polling
  pollJobStatus(data.jobId);
      } else {
        alert('Error en la carga masiva');
      }
    } catch (err) {
      console.error('Bulk upload error', err);
      alert('Error al subir el archivo');
    } finally {
      setLoading(false);
    }
  };

  const pollJobStatus = async (id: string) => {
    try {
      const token = localStorage.getItem('token');
      const interval = 2000;
      const maxAttempts = 180; // hasta 6 minutos
      let attempts = 0;

      const check = async () => {
        if (cancelPollingRef.current) return;
        attempts++;
        const res = await fetch(`http://localhost:5000/api/persons/bulk/${id}/status`, {
          headers: { ...(token ? { Authorization: `Bearer ${token}` } : {}) }
        });
        if (!res.ok) throw new Error('Error consultando estado');
        const json = await res.json();
        if (json.success) {
          setJobStatus(json.data.status);
          if (json.data.status === 'completed' || json.data.status === 'failed' || json.data.status === 'finished_with_errors') {
            if (onUploaded) onUploaded();
            return;
          }
        }
        if (attempts < maxAttempts) {
          if (!cancelPollingRef.current) setTimeout(check, interval);
        }
      };

      check();
    } catch (err) {
      console.error('Poll job error', err);
    }
  };

  return (
    <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div className="bg-white rounded-lg p-4 w-full max-w-2xl max-h-screen overflow-y-auto">
        <div className="flex justify-between items-center mb-2">
          <h3 className="text-lg font-semibold text-gray-900">Carga masiva de personas</h3>
          <button onClick={handleClose} className="text-gray-500">✕</button>
        </div>

        <div className="space-y-4">
          <div>
            <label className="block text-sm text-gray-600 mb-1">Tipo de Persona (se aplicará a todas las filas)</label>
            <select value={tipoPersona} onChange={e => setTipoPersona(e.target.value as 'Estudiante'|'Profesor'|'Colaborador'|'Publico'|'')} className="px-3 py-2 border rounded-md">
              <option value="">-- Seleccione --</option>
              <option value="Estudiante">Estudiante</option>
              <option value="Profesor">Profesor</option>
              <option value="Colaborador">Colaborador</option>
              <option value="Publico">Público</option>
            </select>
          </div>

          <div>
            <input type="file" accept=".csv,text/csv,.xls,.xlsx" onChange={e => handleFile(e.target.files?.[0])} />
            {!tipoPersona && <div className="text-xs text-gray-500 mt-2">Seleccione el tipo de persona antes de subir el archivo</div>}
            {file && (file.name.endsWith('.xls') || file.name.endsWith('.xlsx')) && (
              <div className="text-xs text-gray-500 mt-2">Preview no disponible para archivos Excel; se procesará en el servidor.</div>
            )}
          </div>

          {previewRows.length > 0 && (
            <div>
              <div className="text-xs text-gray-600 mb-2">Vista previa (primeras {previewRows.length} filas)</div>
              <div className="overflow-auto border rounded p-2 text-sm">
                <table className="w-full table-auto">
                  <tbody>
                    {previewRows.map((r,i) => (
                      <tr key={i} className="odd:bg-gray-50">
                        {r.map((c, idx) => <td key={idx} className="px-2 py-1 border-r">{c}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          <div>
            {jobId && (
              <div className="mb-3 text-sm text-gray-700">Job: {jobId} — Estado: {jobStatus}</div>
            )}

            <div className="flex justify-end space-x-3">
              <button onClick={handleClose} className="px-4 py-2 bg-gray-200 rounded">Cancelar</button>
              <button onClick={handleSubmit} disabled={loading || !!jobId || !tipoPersona || !file} className="px-4 py-2 bg-blue-600 text-white rounded">{loading ? 'Subiendo...' : jobId ? 'Encolado' : 'Subir'}</button>
            </div>

            {jobId && jobStatus && jobStatus !== 'queued' && (
              <div className="mt-3">
                {jobStatus === 'completed' && <div className="text-sm text-green-600">Carga completada correctamente.</div>}
                {(jobStatus === 'failed' || jobStatus === 'finished_with_errors') && (
                  <div className="text-sm text-red-600">La carga terminó con errores. <a className="underline" href={`http://localhost:5000/api/persons/bulk/${jobId}/report`}>Descargar reporte</a></div>
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};

export default BulkUploadModal;
