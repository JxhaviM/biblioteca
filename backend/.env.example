# ===========================
# CONFIGURACIÓN DE BASE DE DATOS
# ===========================
MONGO_URI=mongodb://localhost:27017/biblioteca
# Para MongoDB Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/biblioteca

# ===========================
# CONFIGURACIÓN JWT
# ===========================
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui_cambialo_en_produccion
JWT_EXPIRE=7d

# ===========================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================
NODE_ENV=production
PORT=5000

# ===========================
# CONFIGURACIÓN DE CORS
# ===========================
FRONTEND_URL=https://tu-dominio-frontend.com
ALLOWED_ORIGINS=https://tu-dominio-frontend.com,https://otro-dominio.com

# ===========================
# SUPERADMIN (Creación automática)
# ===========================
SUPERADMIN_EMAIL=admin@tu-dominio.com
SUPERADMIN_PASSWORD=tu-contraseña-segura
SUPERADMIN_DOC=1234567890
SUPERADMIN_NAME=Administrador Principal
SUPERADMIN_DOC_TYPE=CC
SUPERADMIN_GENDER=M
SUPERADMIN_PHONE=+573001234567
SUPERADMIN_ADDRESS=Dirección del administrador

# ===========================
# CONFIGURACIÓN DE EMAIL (Futuro)
# ===========================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=tu_email@gmail.com
# EMAIL_PASS=tu_password_de_aplicacion

# ===========================
# CONFIGURACIÓN DE LOGS (Futuro)
# ===========================
# LOG_LEVEL=debug
# LOG_FILE=logs/biblioteca.log

# ===========================
# CONFIGURACIÓN DE CACHE (Futuro)
# ===========================
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# ===========================
# CONFIGURACIÓN DE LÍMITES
# ===========================
LOAN_DEFAULT_DAYS=7
LOAN_MAX_RENEWALS=2
LOAN_EXTENDED_DAYS=14
MAX_LOANS_PER_STUDENT=5

# ===========================
# CONFIGURACIÓN DE FEATURES
# ===========================
ENABLE_AUTH_MIDDLEWARE=false
ENABLE_RATE_LIMITING=false
ENABLE_AUTO_MAINTENANCE=true
MAINTENANCE_HOUR=2
